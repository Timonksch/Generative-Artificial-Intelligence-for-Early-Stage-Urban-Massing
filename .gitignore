htmlcov/

# Virtual environments and local environment variables
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging output
build/
dist/
*.egg-info/

# Runtime caches and logs
.cache/
.artifacts/
.mplconfig/
*.log
runs/

# Large input data. Documentation and curated examples remain trackable.
00_Data/01_InputData/*
