{
  "name": "phase1_06_loss_balance",
  "description": "Phase 1 step 6: tune loss weights at 64³ resolution to balance volume and surface adherence.",
  "global": {
    "data_root": "00_Data/02_GeneratedDatasets/dataset_thesis",
    "split_manifest": "00_Data/02_GeneratedDatasets/dataset_thesis/report_split.json",
    "epochs": 10,
    "batch_size": 2,
    "accum_steps": 2,
    "lr": 0.0007,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "lr_schedule": "cosine",
    "seed": 42,
    "num_workers": 4,
    "downsample_stride": 4,
    "crop_size": 0,
    "add_coords": false,
    "auto_thresh": true,
    "thresh_grid": [
      0.40,
      0.45,
      0.50,
      0.55,
      0.60
    ],
    "tta": false,
    "early_stop_patience": 0,
    "log_every": 5,
    "save_every": 10,
    "vis_every": 5,
    "grad_clip": 1.0
  },
  "overrides": [
    {
      "model": "unet",
      "run_name": "phase1_local_loss_balance_lowvol",
      "description": "Remove volume regularizer to test pure surface+Dice loss behaviour.",
      "volume_reg_weight": 0.0,
      "base_ch": 16,
      "depth": 4
    },
    {
      "model": "unet",
      "run_name": "phase1_local_loss_balance_surface",
      "description": "Boost surface weight and moderate volume regularizer for sharper edges.",
      "surface_weight": 1.5,
      "volume_reg_weight": 0.2,
      "base_ch": 16,
      "depth": 4
    }
  ]
}
