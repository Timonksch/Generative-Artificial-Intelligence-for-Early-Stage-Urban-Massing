{
  "name": "phase1_02_capacity",
  "description": "Phase 1 follow-up: compare shallower vs wider capacity against the baseline reference.",
  "global": {
    "data_root": "00_Data/02_GeneratedDatasets/dataset_thesis",
    "split_manifest": "00_Data/02_GeneratedDatasets/dataset_thesis/report_split.json",
    "epochs": 10,
    "batch_size": 2,
    "accum_steps": 2,
    "lr": 0.0007,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "lr_schedule": "cosine",
    "seed": 42,
    "num_workers": 4,
    "downsample_stride": 4,
    "crop_size": 0,
    "add_coords": false,
    "auto_thresh": true,
    "thresh_grid": [
      0.40,
      0.45,
      0.50,
      0.55,
      0.60
    ],
    "tta": false,
    "early_stop_patience": 0,
    "log_every": 5,
    "save_every": 10,
    "vis_every": 5,
    "grad_clip": 1.0
  },
  "overrides": [
    {
      "model": "unet",
      "run_name": "phase1_local_capacity_down",
      "description": "Shallower network (depth=3, base_ch=12) to gauge minimal capacity before sweeps.",
      "base_ch": 12,
      "depth": 3
    },
    {
      "model": "unet",
      "run_name": "phase1_local_capacity_up",
      "description": "Higher-capacity variant (depth=4, base_ch=24) to test benefits of wider encoder-decoder.",
      "base_ch": 24,
      "depth": 4
    }
  ]
}
