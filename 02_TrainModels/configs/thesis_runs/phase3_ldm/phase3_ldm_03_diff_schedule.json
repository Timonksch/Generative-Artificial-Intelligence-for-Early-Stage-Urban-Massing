{
  "name": "phase3_ldm_03_diff_schedule",
  "description": "Stage-B schedule and diffusion-horizon sweep after the frozen final VAE. Configured for the retained Stage-A final VAE at latent_res=32 with the corresponding frozen checkpoint. Selection is based on minimum validation L_diff.",
  "global": {
    "data_root": "00_Data/02_GeneratedDatasets/dataset_thesis",
    "split_manifest": "00_Data/02_GeneratedDatasets/dataset_thesis/report_split.json",
    "epochs": 10,
    "batch_size": 2,
    "accum_steps": 4,
    "lr": 0.0002,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "lr_schedule": "cosine",
    "seed": 42,
    "num_workers": 6,
    "downsample_stride": 4,
    "crop_size": 0,
    "add_coords": false,
    "early_stop_patience": 0,
    "log_every": 10,
    "save_every": 0,
    "vis_every": 5,
    "grad_clip": 1.0,
    "auto_thresh": true,
    "thresh_grid": [
      0.40,
      0.45,
      0.50,
      0.55,
      0.60
    ],
    "cond_select": [
      0,
      1,
      2
    ],
    "cond_drop": 0.02,
    "mode": "diffusion",
    "input_res": 64,
    "latent_res": 32,
    "latent_channels": 4,
    "vae_base_ch": 32,
    "kl_weight": 0.0,
    "kl_anneal_epochs": 0,
    "diff_base_ch": 64,
    "diff_depth": 3,
    "time_dim": 256,
    "train_timesteps": 1000,
    "noise_schedule": "cosine",
    "sampler": "ddim",
    "sample_timesteps": 100,
    "ddim_eta": 0.0,
    "cfg_scale": 2.0,
    "ema": true,
    "ema_decay": 0.999,
    "vae_checkpoint": "02_TrainModels/outputs/thesis_runs/architecture_phase3_ldm/phase3_final_vae/phase3_final_vae_lat32_ch4_base32_beta3e-4/best.pt",
    "sample_every": 5,
    "num_sample_batches": 2,
    "num_sample_conds": 3,
    "ema_sample_start": 5
  },
  "overrides": [
    {
      "model": "ldm",
      "run_name": "phase3_ldm_diff_cosine_t1000",
      "description": "Reference Stage-B diffusion setup with cosine schedule and 1000 training steps."
    },
    {
      "model": "ldm",
      "run_name": "phase3_ldm_diff_linear_t1000",
      "description": "Linear beta schedule under the same diffusion horizon.",
      "noise_schedule": "linear"
    },
    {
      "model": "ldm",
      "run_name": "phase3_ldm_diff_cosine_t500",
      "description": "Reduced diffusion horizon to test whether a shorter chain remains sufficient in latent space.",
      "train_timesteps": 500
    }
  ]
}
