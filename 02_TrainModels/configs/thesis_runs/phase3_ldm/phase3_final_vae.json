{
  "name": "phase3_final_vae",
  "description": "50-epoch Stage-A final run, updated to the retained global VAE winner from the completed compression and capacity sweeps. The resulting checkpoint is then frozen and reused by all Stage-B diffusion experiments.",
  "global": {
    "data_root": "00_Data/02_GeneratedDatasets/dataset_thesis",
    "split_manifest": "00_Data/02_GeneratedDatasets/dataset_thesis/report_split.json",
    "epochs": 50,
    "batch_size": 1,
    "accum_steps": 4,
    "lr": 0.0002,
    "optimizer": "adamw",
    "weight_decay": 0.01,
    "lr_schedule": "cosine",
    "seed": 42,
    "num_workers": 6,
    "downsample_stride": 4,
    "crop_size": 0,
    "add_coords": false,
    "early_stop_patience": 0,
    "log_every": 10,
    "save_every": 5,
    "vis_every": 5,
    "grad_clip": 1.0,
    "auto_thresh": true,
    "thresh_grid": [
      0.40,
      0.45,
      0.50,
      0.55,
      0.60
    ],
    "cond_select": [
      0,
      1,
      2
    ],
    "cond_drop": 0.0,
    "mode": "vae_pretrain",
    "input_res": 64,
    "latent_res": 32,
    "latent_channels": 4,
    "vae_base_ch": 32,
    "kl_weight": 0.0003,
    "kl_anneal_epochs": 10,
    "diff_base_ch": 64,
    "diff_depth": 3,
    "time_dim": 256,
    "train_timesteps": 1000,
    "noise_schedule": "cosine",
    "sampler": "ddim",
    "sample_timesteps": 100,
    "ddim_eta": 0.0,
    "cfg_scale": 2.0,
    "ema": true,
    "ema_decay": 0.999,
    "vae_checkpoint": null,
    "sample_every": 5,
    "num_sample_batches": 2,
    "num_sample_conds": 3,
    "ema_sample_start": 3
  },
  "overrides": [
    {
      "model": "ldm",
      "run_name": "phase3_final_vae_lat32_ch4_base32_beta3e-4",
      "description": "Stage-A final VAE run using the retained global sweep winner: latent_res=32, latent_channels=4, vae_base_ch=32, kl_weight=3e-4."
    }
  ]
}
